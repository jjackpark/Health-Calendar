import assert from 'node:assert/strict';
import {test} from 'node:test';
import {recordSchema,summarize,isDate} from '../lib/health.ts';
test('validates calendar dates and bounded records',()=>{assert.equal(isDate('2026-02-30'),false);assert.equal(isDate('2024-02-29'),true);assert.equal(recordSchema.safeParse({date:'2026-09-19',metric:'steps',value:-1}).success,false);assert.equal(recordSchema.safeParse({date:'2026-09-19',metric:'steps',value:1.5}).success,false);assert.equal(recordSchema.safeParse({date:'2026-09-19',metric:'sleep',value:1500}).success,false);assert.equal(recordSchema.safeParse({date:'2026-09-19',metric:'alcohol',value:500,kind:'맥주',abv:4.5}).success,true)});
test('missing days excluded from averages; explicit zero retained',()=>{const rows=[{date:'2026-09-18',metric:'steps',value:8000},{date:'2026-09-19',metric:'steps',value:0},{date:'2026-09-19',metric:'alcohol',value:0},{date:'2026-09-18',metric:'alcohol',value:500}];const s=summarize(rows as any,['2026-09-17','2026-09-18','2026-09-19'],8000);assert.equal(s.average,4000);assert.equal(s.recorded,2);assert.equal(s.achieved,1);assert.equal(s.alcohol,1);assert.equal(s.alcoholRecorded,2);assert.equal(s.sleep,null)});
